[Desktop Entry]
Type=Application
Name=@DT_NAME@
GenericName=Disk Usage Analyzer
GenericName[tr]=Disk Kullanım Analizörü
Comment=See what takes up space with a tree, an extension list and a treemap
Comment[tr]=Disk kullanımını ağaç, uzantı listesi ve treemap ile gösterir
Keywords=disk;usage;space;treemap;windirstat;duplicates;cleanup;
Keywords[tr]=disk;kullanım;alan;treemap;windirstat;kopya;temizlik;
Exec=@DT_EXEC@ %f
Icon=tuxdirstat
Terminal=false
Categories=@DT_CATS@
StartupNotify=true
